{
    "name": "@atlasclean/backend",
    "version": "1.0.0",
    "description": "AtlasCleanAI Enterprise Backend API",
    "main": "dist/server.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "test": "jest --coverage",
        "test:unit": "jest tests/unit --coverage",
        "test:integration": "jest tests/integration",
        "lint": "eslint src/**/*.ts",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:push": "prisma db push"
    },
    "dependencies": {
        "@prisma/client": "^5.0.0",
        "aws-sdk": "^2.1427.0",
        "axios": "^1.16.0",
        "bcryptjs": "^2.4.3",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "date-fns": "^2.30.0",
        "express": "^4.18.2",
        "express-rate-limit": "^6.10.0",
        "express-validator": "^7.0.1",
        "firebase-admin": "^11.10.1",
        "helmet": "^7.0.0",
        "ioredis": "^5.3.2",
        "jsonwebtoken": "^9.0.0",
        "morgan": "^1.10.0",
        "multer": "^2.2.0",
        "nodemailer": "^9.0.3",
        "socket.io": "^4.7.1",
        "stripe": "^12.17.0",
        "uuid": "^9.0.0",
        "winston": "^3.10.0",
        "zod": "^3.21.4"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.2",
        "@types/compression": "^1.7.2",
        "@types/cors": "^2.8.13",
        "@types/express": "^4.17.17",
        "@types/jest": "^29.5.3",
        "@types/jsonwebtoken": "^9.0.2",
        "@types/morgan": "^1.9.5",
        "@types/multer": "^1.4.7",
        "@types/node": "^20.4.9",
        "@types/nodemailer": "^6.4.9",
        "@types/supertest": "^2.0.12",
        "@types/uuid": "^9.0.2",
        "@typescript-eslint/eslint-plugin": "^6.3.0",
        "@typescript-eslint/parser": "^6.3.0",
        "eslint": "^8.47.0",
        "jest": "^29.6.2",
        "prisma": "^5.0.0",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.1",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.1.6"
    },
    "prisma": {
        "schema": "src/infrastructure/database/prisma/schema.prisma"
    },
    "jest": {
        "preset": "ts-jest",
        "testEnvironment": "node",
        "roots": [
            "<rootDir>/tests"
        ],
        "collectCoverageFrom": [
            "src/**/*.ts",
            "!src/server.ts"
        ],
        "setupFiles": [
            "<rootDir>/tests/setup.ts"
        ]
    },
    "eslintConfig": {
        "root": true,
        "env": {
            "node": true,
            "es2022": true,
            "jest": true
        },
        "parser": "@typescript-eslint/parser",
        "parserOptions": {
            "project": "./tsconfig.json"
        },
        "plugins": [
            "@typescript-eslint"
        ],
        "extends": [
            "eslint:recommended",
            "plugin:@typescript-eslint/recommended"
        ],
        "ignorePatterns": [
            "dist",
            "node_modules"
        ],
        "rules": {
            "@typescript-eslint/no-explicit-any": "off",
            "@typescript-eslint/explicit-module-boundary-types": "off"
        }
    }
}
