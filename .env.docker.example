# Copy this file to .env.docker and fill in real values before running docker-compose.
# Never commit .env.docker to version control.

POSTGRES_DB=atlasclean_db
POSTGRES_USER=atlasclean
POSTGRES_PASSWORD=change_me_local_only

JWT_SECRET=change_me_local_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_local_refresh_secret_min_32_chars
